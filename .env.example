# Copy to .env at repository root. Replace placeholders before startup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus_resources
MYSQL_USER=campus_app
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
# Must be >=32 characters; generate a unique random key for each environment.
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=60
# D database sessions; production HTTPS must set SESSION_COOKIE_SECURE=true.
SESSION_MINUTES=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
BOOKING_MAX_HOURS=4
BOOKING_WINDOW_DAYS=7
# Only for demo seeding; minimum 12 characters. Never a real account password.
SEED_USER_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
# M3 elapsed-hour deadlines; changing these also changes open orders' deadlines.
M3_REPORTED_TIMEOUT_HOURS=24
M3_ASSIGNED_TIMEOUT_HOURS=24
M3_REPAIRING_TIMEOUT_HOURS=48
M3_ACCEPTANCE_TIMEOUT_HOURS=24
M3_TIMEOUT_SCAN_INTERVAL_SECONDS=60
M3_TIMEOUT_SCAN_ENABLED=true
# Compose MySQL startup; only used by the local mysql container.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
